OPENAI_API_KEY=sk-your-key-here

# ─── Replicate (primary photo generation) ────────────────────────────────────
REPLICATE_API_TOKEN=r8_your-token-here

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
